---
// Contact Section Component
const email = 'karlosleon5@gmail.com';
const profiles = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/carlos-leon-39a11737b/' },
  { label: 'GitHub', href: 'https://github.com/ryxploit' },
];
---

<section id="contacto" class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <h2 class="text-4xl sm:text-5xl font-bold tracking-tight max-w-[18ch]">¿Tienes un proyecto en mente?</h2>
    <p class="mt-5 text-lg text-paper/70 max-w-[46ch]">
      Cuéntame qué quieres construir o qué proceso quieres automatizar. Respondo por correo.
    </p>

    <a
      href={`mailto:${email}`}
      class="mt-12 inline-block break-all text-[clamp(1.6rem,0.9rem+3.6vw,4rem)] font-bold leading-tight tracking-tight text-marigold underline decoration-paper/25 decoration-2 underline-offset-[0.18em] hover:decoration-marigold transition-colors"
    >
      {email}
    </a>

    <ul class="mt-12 flex flex-wrap gap-3">
      {profiles.map((profile) => (
        <li>
          <a
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full border border-paper/25 px-6 py-3 font-semibold hover:border-paper transition-colors"
          >
            {profile.label}
            <span class="sr-only">(abre en una pestaña nueva)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
