---
// Contact Section Component
---

<section id="contacto" class="py-20 lg:py-32 bg-slate-900 relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl -translate-x-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-green-500/5 rounded-full blur-3xl translate-x-1/2"></div>

  <div class="container mx-auto px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center px-4 py-2 bg-blue-500/10 border border-blue-500/20 rounded-full text-sm text-blue-400 mb-6">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        Contacto
      </span>
      <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-white mb-6">
        ¿Tienes un <span class="text-gradient">Proyecto</span> en Mente?
      </h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        Estoy disponible para nuevos proyectos y colaboraciones. ¡Hablemos sobre cómo puedo ayudarte a hacer realidad tu idea!
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-12 max-w-7xl mx-auto">
      <!-- Contact Info -->
      <div class="lg:col-span-2 space-y-8">
        <div>
          <h3 class="text-2xl font-bold text-white mb-4">Información de Contacto</h3>
          <p class="text-slate-400">
            Contáctame directamente o conéctate conmigo en LinkedIn para discutir tu próximo proyecto.
          </p>
        </div>

        <!-- Contact Methods -->
        <div class="space-y-6">
          {[
            { icon: 'map-marker', title: 'Ubicación', desc: 'Mazatlán, Sinaloa, México', value: '', color: 'purple', link: null },
            { icon: 'envelope', title: 'Email', desc: 'Respuesta en menos de 24 horas', value: 'karlosleon5@gmail.com', color: 'blue', link: 'mailto:karlosleon5@gmail.com' },
            { icon: 'linkedin', title: 'LinkedIn', desc: 'Perfil profesional', value: 'Carlos León', color: 'linkedin', link: 'https://www.linkedin.com/in/carlos-leon-39a11737b/' },
            { icon: 'globe', title: 'Portfolio', desc: 'Proyectos y soluciones', value: 'ryxploit.github.io', color: 'green', link: 'https://ryxploit.github.io/' }
          ].map((item) => (
            <a href={item.link || '#'} target={item.link ? '_blank' : undefined} rel={item.link ? 'noopener noreferrer' : undefined} class="group flex items-start space-x-4 cursor-pointer">
              <div class={`w-12 h-12 bg-${item.color}-500/20 rounded-xl flex items-center justify-center group-hover:bg-${item.color}-500/30 transition-colors shrink-0`}>
                {item.icon === 'map-marker' && <svg class={`w-5 h-5 text-${item.color}-400`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>}
                {item.icon === 'envelope' && <svg class={`w-5 h-5 text-${item.color}-400`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>}
                {item.icon === 'linkedin' && <svg class={`w-5 h-5 text-${item.color}-400`} fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
                {item.icon === 'globe' && <svg class={`w-5 h-5 text-${item.color}-400`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>}
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1 group-hover:text-green-400 transition-colors">{item.title}</h4>
                <p class="text-sm text-slate-500 mb-1">{item.desc}</p>
                <span class={`text-${item.color}-400 font-medium text-sm`}>{item.value}</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Social Links -->
        <div class="pt-8 border-t border-slate-700/50">
          <h4 class="font-semibold text-white mb-4">Sígueme en redes</h4>
          <div class="flex space-x-3">
            {[
              { icon: 'github', link: 'https://github.com/ryxploit', color: 'slate' },
              { icon: 'linkedin', link: 'https://www.linkedin.com/in/carlos-leon-39a11737b/', color: 'linkedin' }
            ].map((social) => (
              <a href={social.link} target="_blank" rel="noopener noreferrer" class={`w-11 h-11 bg-${social.color}-500/20 hover:bg-${social.color}-500/30 rounded-xl flex items-center justify-center text-${social.color}-400 hover:text-${social.color}-300 transition-all cursor-pointer hover:scale-110`}>
                {social.icon === 'github' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>}
                {social.icon === 'linkedin' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
                {social.icon === 'instagram' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-3 bg-slate-800/80 border border-slate-700/50 rounded-3xl p-8">
        <h3 class="text-2xl font-bold text-white mb-6">Envíame un mensaje</h3>

        <form id="contact-form" action="https://formspree.io/f/karlosleon5@gmail.com" method="POST" class="space-y-6">
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-medium text-slate-300 mb-2">Nombre completo *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3.5 bg-slate-900/50 border border-slate-700/50 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-transparent transition-all"
              placeholder="Tu nombre completo"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-medium text-slate-300 mb-2">Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3.5 bg-slate-900/50 border border-slate-700/50 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-transparent transition-all"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Company -->
          <div>
            <label for="company" class="block text-sm font-medium text-slate-300 mb-2">Empresa / Organización</label>
            <input
              type="text"
              id="company"
              name="company"
              class="w-full px-4 py-3.5 bg-slate-900/50 border border-slate-700/50 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-transparent transition-all"
              placeholder="Nombre de tu empresa (opcional)"
            />
          </div>

          <!-- Project Type & Budget Grid -->
          <div class="grid md:grid-cols-2 gap-4">
            <!-- Project Type -->
            <div>
              <label for="project-type" class="block text-sm font-medium text-slate-300 mb-2">Tipo de proyecto *</label>
              <select
                id="project-type"
                name="project-type"
                required
                class="w-full px-4 py-3.5 bg-slate-900/50 border border-slate-700/50 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-transparent transition-all cursor-pointer"
              >
                <option value="">Selecciona el tipo</option>
                <option value="web-app">Aplicación Web</option>
                <option value="mobile-app">Aplicación Móvil</option>
                <option value="automation">Automatización</option>
                <option value="data-analytics">Data Analytics</option>
                <option value="ai-integration">Integración de IA</option>
                <option value="consulting">Consultoría</option>
                <option value="other">Otro</option>
              </select>
            </div>

            <!-- Budget -->
            <div>
              <label for="budget" class="block text-sm font-medium text-slate-300 mb-2">Presupuesto estimado</label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3.5 bg-slate-900/50 border border-slate-700/50 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-transparent transition-all cursor-pointer"
              >
                <option value="">Selecciona un rango</option>
                <option value="under-5k">Menos de $5,000 USD</option>
                <option value="5k-10k">$5,000 - $10,000 USD</option>
                <option value="10k-25k">$10,000 - $25,000 USD</option>
                <option value="25k-50k">$25,000 - $50,000 USD</option>
                <option value="over-50k">Más de $50,000 USD</option>
              </select>
            </div>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-medium text-slate-300 mb-2">Mensaje *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3.5 bg-slate-900/50 border border-slate-700/50 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500/50 focus:border-transparent transition-all resize-none"
              placeholder="Cuéntame sobre tu proyecto, objetivos, timeline y cualquier detalle relevante..."
            ></textarea>
          </div>

          <!-- Hidden fields for Formspree -->
          <input type="hidden" name="_subject" value="Nuevo mensaje desde tu Portfolio" />
          <input type="hidden" name="_next" value="https://ryxploit.github.io/#contacto" />

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="group w-full flex items-center justify-center px-8 py-4 bg-green-500 hover:bg-green-400 text-slate-900 font-semibold rounded-xl transition-all duration-200 hover:scale-[1.02] shadow-lg shadow-green-500/25 cursor-pointer"
          >
            <span id="btn-text" class="flex items-center">
              <svg class="w-5 h-5 mr-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Enviar mensaje
            </span>
            <span id="btn-loading" class="hidden flex items-center">
              <svg class="w-5 h-5 mr-2 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              Enviando...
            </span>
          </button>

          <!-- Status Message -->
          <div id="form-status" class="hidden p-4 rounded-xl text-center font-medium"></div>
        </form>

        <!-- Response Time -->
        <div class="mt-6 p-4 bg-green-500/10 border border-green-500/20 rounded-xl">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-green-500/20 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-green-400">Tiempo de respuesta</p>
              <p class="text-xs text-slate-500">Normalmente respondo en menos de 24 horas</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const feedbackDiv = document.getElementById('form-status') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = submitBtn.querySelector('#btn-text') as HTMLElement;
    const btnLoader = submitBtn.querySelector('#btn-loading') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (form.elements.namedItem('name') as HTMLInputElement).value;
      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value;

      if (!name || !email || !message) {
        feedbackDiv.className = 'p-4 rounded-xl text-center font-medium bg-red-500/10 text-red-400 border border-red-500/20';
        feedbackDiv.textContent = 'Por favor, completa todos los campos requeridos.';
        feedbackDiv.classList.remove('hidden');
        return;
      }

      btnText.classList.add('hidden');
      btnLoader.classList.remove('hidden');
      submitBtn.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          feedbackDiv.className = 'p-4 rounded-xl text-center font-medium bg-green-500/10 text-green-400 border border-green-500/20';
          feedbackDiv.textContent = '¡Gracias por tu mensaje! Te responderé pronto.';
          feedbackDiv.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error('Error en el envío');
        }
      } catch (error) {
        feedbackDiv.className = 'p-4 rounded-xl text-center font-medium bg-red-500/10 text-red-400 border border-red-500/20';
        feedbackDiv.textContent = 'Hubo un error al enviar tu mensaje. Por favor intenta de nuevo.';
        feedbackDiv.classList.remove('hidden');
      } finally {
        btnText.classList.remove('hidden');
        btnLoader.classList.add('hidden');
        submitBtn.disabled = false;

        setTimeout(() => {
          feedbackDiv.classList.add('hidden');
        }, 5000);
      }
    });
  });
</script>