---
// Hero Section Component
---

<section id="inicio" class="min-h-screen flex items-center justify-center relative overflow-hidden bg-slate-900">
  <!-- Animated Background Grid -->
  <div class="absolute inset-0 opacity-20">
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(34, 197, 94, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(34, 197, 94, 0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
  </div>

  <!-- Floating Gradient Orbs -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-green-500/10 rounded-full blur-3xl animate-pulse"></div>
  <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>

  <div class="container mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content Column -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Badge -->
        <div class="inline-flex items-center px-4 py-2 bg-green-500/10 border border-green-500/20 rounded-full text-sm text-green-400 mb-6 hover:bg-green-500/20 transition-colors cursor-pointer">
          <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
          Disponible para nuevos proyectos
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 leading-tight">
          <span class="text-white">Hola, soy</span><br>
          <span class="text-gradient">Carlos León</span>
        </h1>

        <div class="flex items-center justify-center lg:justify-start gap-2 mb-6">
          <span class="text-xl lg:text-2xl text-slate-400">//</span>
          <span id="typing-text" class="text-xl lg:text-2xl text-green-400 font-medium"></span>
        </div>

        <p class="text-lg lg:text-xl text-slate-400 mb-8 max-w-xl leading-relaxed">
          Desarrollador web y móvil con experiencia en automatización de procesos,
          integración de sistemas y uso aplicado de inteligencia artificial.
        </p>

        <!-- Tech Stack Icons -->
        <div class="flex flex-wrap gap-3 mb-10 justify-center lg:justify-start">
          {['JavaScript', 'Node.js', 'Flutter', 'Google Apps Script', 'PostgreSQL', 'IA'].map((tech) => (
            <span class="px-4 py-2 bg-slate-800/80 border border-slate-700/50 rounded-lg text-sm text-slate-300 hover:border-green-500/50 hover:text-green-400 transition-all cursor-pointer">
              {tech}
            </span>
          ))}
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-12">
          <a href="#proyectos" class="group inline-flex items-center justify-center px-8 py-4 bg-green-500 hover:bg-green-400 text-slate-900 font-semibold rounded-xl transition-all duration-200 hover:scale-105 shadow-lg shadow-green-500/25 cursor-pointer">
            <svg class="w-5 h-5 mr-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            Ver Proyectos
          </a>
          <a href="#contacto" class="group inline-flex items-center justify-center px-8 py-4 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/50 text-white font-semibold rounded-xl transition-all duration-200 hover:scale-105 cursor-pointer">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Contactar
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 pt-8 border-t border-slate-800/50">
          <div class="text-center lg:text-left">
            <div class="text-3xl lg:text-4xl font-bold text-white mb-1">8+</div>
            <div class="text-sm text-slate-500">Años Experiencia</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-3xl lg:text-4xl font-bold text-green-400 mb-1">50+</div>
            <div class="text-sm text-slate-500">Proyectos</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-3xl lg:text-4xl font-bold text-emerald-400 mb-1">100%</div>
            <div class="text-sm text-slate-500">Satisfacción</div>
          </div>
        </div>
      </div>

      <!-- Image Column -->
      <div class="flex justify-center lg:justify-end order-1 lg:order-2">
        <div class="relative">
          <!-- Main Profile Circle -->
          <div class="relative w-72 h-72 sm:w-80 sm:h-80 lg:w-96 lg:h-96 group">
            <!-- Gradient Ring -->
            <div class="absolute inset-0 rounded-full bg-gradient-to-br from-green-500 to-emerald-600 p-1">
              <div class="w-full h-full rounded-full bg-slate-900"></div>
            </div>
            <!-- Image -->
            <div class="absolute inset-2 rounded-full overflow-hidden">
              <img
                src="/perfil.jpeg"
                alt="Carlos León - Automation & Data Developer"
                class="w-full h-full object-cover"
              />
            </div>
            <!-- Glow Effect -->
            <div class="absolute inset-0 rounded-full bg-green-500/20 blur-2xl group-hover:bg-green-500/30 transition-colors"></div>
          </div>

          <!-- Floating Badge - Automation -->
          <div class="absolute -top-4 right-4 bg-slate-800/90 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-4 shadow-xl animate-bounce cursor-pointer">
            <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>

          <!-- Floating Badge - AI -->
          <div class="absolute -bottom-4 left-4 bg-slate-800/90 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-4 shadow-xl animate-bounce cursor-pointer" style="animation-delay: 0.5s;">
            <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>

          <!-- Floating Badge - Data -->
          <div class="absolute top-1/2 -left-8 bg-slate-800/90 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-3 shadow-xl animate-bounce cursor-pointer" style="animation-delay: 1s;">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
      <a href="#sobre-mi" class="flex flex-col items-center text-slate-500 hover:text-green-400 transition-colors cursor-pointer group">
        <span class="text-xs mb-2 opacity-60 group-hover:opacity-100">Scroll</span>
        <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const typingElement = document.getElementById('typing-text');
    if (!typingElement) return;

    const texts = [
      'Automation & Data Developer',
      'Web & Mobile Developer',
      'AI Integration Specialist',
      'Process Automation Expert'
    ];
    let textIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function typeText() {
      if (!typingElement) return;

      const currentText = texts[textIndex];

      if (isDeleting) {
        typingElement.textContent = currentText.substring(0, charIndex - 1);
        charIndex--;
      } else {
        typingElement.textContent = currentText.substring(0, charIndex + 1);
        charIndex++;
      }

      let typeSpeed = isDeleting ? 50 : 100;

      if (!isDeleting && charIndex === currentText.length) {
        typeSpeed = 2000;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        textIndex = (textIndex + 1) % texts.length;
      }

      setTimeout(typeText, typeSpeed);
    }

    typeText();
  });
</script>