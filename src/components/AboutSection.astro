---
// About Section Component
---

<section id="sobre-mi" class="py-20 lg:py-32 bg-slate-900 relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-green-500/5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>

  <div class="container mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Content Column -->
      <div class="order-2 lg:order-1">
        <!-- Badge -->
        <span class="inline-flex items-center px-4 py-2 bg-green-500/10 border border-green-500/20 rounded-full text-sm text-green-400 mb-6">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          Sobre Mí
        </span>

        <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-white mb-6 leading-tight">
          Automation & <span class="text-gradient">Data Developer</span>
        </h2>

        <div class="space-y-6 text-slate-400 leading-relaxed">
          <p class="text-lg">
            Desarrollador web y móvil con experiencia en <strong class="text-white">automatización de procesos</strong>,
            <strong class="text-white">integración de sistemas</strong> y <strong class="text-white">uso aplicado de inteligencia artificial</strong>.
          </p>

          <p>
            He trabajado en la construcción de soluciones que <strong class="text-white">centralizan información</strong>,
            <strong class="text-white">optimizan operaciones</strong> y generan <strong class="text-white">reportes para la toma de decisiones</strong>.
          </p>

          <p>
            Cuento con una base sólida en <strong class="text-white">desarrollo</strong>, <strong class="text-white">bases de datos</strong>
            y <strong class="text-white">automatización</strong>, con interés en seguir creciendo en áreas de
            <strong class="text-white">Data Analytics</strong> e inteligencia artificial aplicada.
          </p>
        </div>

        <!-- Specialties -->
        <div class="mt-10">
          <h3 class="text-xl font-semibold text-white mb-6">Especialidades</h3>
          <div class="grid grid-cols-2 gap-y-4 gap-x-8">
            {[
              { text: 'Automatización de Procesos', color: 'green' },
              { text: 'Desarrollo Web', color: 'purple' },
              { text: 'Desarrollo Móvil', color: 'cyan' },
              { text: 'Integración de APIs', color: 'emerald' },
              { text: 'Inteligencia Artificial', color: 'orange' },
              { text: 'Análisis de Datos', color: 'pink' }
            ].map((item) => (
              <div class="flex items-center space-x-3 group cursor-pointer">
                <div class={`w-3 h-3 bg-${item.color}-500 rounded-full group-hover:scale-125 transition-transform`}></div>
                <span class="text-slate-400 group-hover:text-white transition-colors">{item.text}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mt-10">
          <a href="/assets/CV Carlos Leon.pdf" download class="group inline-flex items-center justify-center px-6 py-3 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/50 text-white font-medium rounded-xl transition-all duration-200 hover:scale-105 cursor-pointer">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            Descargar CV
          </a>
          <a href="#contacto" class="group inline-flex items-center justify-center px-6 py-3 bg-green-500/10 hover:bg-green-500/20 border border-green-500/30 text-green-400 font-medium rounded-xl transition-all duration-200 hover:scale-105 cursor-pointer">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            Hablemos
          </a>
        </div>
      </div>

      <!-- Image & Stats Column -->
      <div class="order-1 lg:order-2 space-y-8">
        <!-- Profile Image -->
        <div class="relative">
          <div class="relative w-full max-w-md mx-auto">
            <div class="aspect-square rounded-3xl overflow-hidden shadow-2xl shadow-green-500/10">
              <img
                src="/perfil.jpeg"
                alt="Carlos León trabajando"
                class="w-full h-full object-cover"
              />
            </div>
            <!-- Decorative Elements -->
            <div class="absolute -top-4 -right-4 w-24 h-24 bg-green-500/20 rounded-full animate-pulse"></div>
            <div class="absolute -bottom-4 -left-4 w-16 h-16 bg-emerald-500/20 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { value: '8+', label: 'Años de Experiencia', color: 'green' },
            { value: '50+', label: 'Proyectos Completados', color: 'purple' },
            { value: '15+', label: 'Tecnologías', color: 'cyan' },
            { value: '100%', label: 'Satisfacción', color: 'emerald' }
          ].map((stat) => (
            <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6 text-center hover:border-green-500/30 transition-colors cursor-pointer">
              <div class={`text-3xl font-bold text-${stat.color}-400 mb-2`}>{stat.value}</div>
              <div class="text-sm text-slate-500">{stat.label}</div>
            </div>
          ))}
        </div>

        <!-- Languages -->
        <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700/50 rounded-2xl p-6">
          <h4 class="font-semibold text-white mb-4">Idiomas</h4>
          <div class="space-y-3">
            {[
              { lang: 'Español', level: 'Nativo', color: 'green' },
              { lang: 'Inglés', level: 'Técnico', color: 'blue' }
            ].map((item) => (
              <div class="flex items-center justify-between cursor-pointer group">
                <span class="text-slate-400 group-hover:text-white transition-colors">{item.lang}</span>
                <span class={`text-${item.color}-400 text-sm font-medium`}>{item.level}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>