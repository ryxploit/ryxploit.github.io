---
// Skills Section Component
const stack = [
  { area: 'Lenguajes', items: ['JavaScript', 'TypeScript', 'Python', 'PHP', 'Dart', 'SQL', 'HTML', 'CSS'] },
  { area: 'Frameworks', items: ['Next.js', 'React', 'Flutter'] },
  { area: 'IA y LLM', items: ['OpenAI', 'Claude', 'Gemini', 'GitHub Copilot', 'DeepSeek', 'MiniMax', 'OpenRouter', 'Hugging Face'] },
  { area: 'Bases de datos', items: ['PostgreSQL', 'MySQL', 'SQLite', 'SQL Server', 'MongoDB', 'Firebase', 'Supabase'] },
  { area: 'Backend y nube', items: ['APIs REST', 'Autenticación', 'Almacenamiento', 'Funciones serverless'] },
  { area: 'Herramientas', items: ['Git', 'VS Code', 'Diseño UI/UX', 'Prototipado'] },
];
---

<section id="stack" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight">Stack</h2>
      <p class="mt-4 text-lg text-muted max-w-[30ch]">Lo que uso para llevar un producto de la idea a producción.</p>
    </div>

    <dl class="lg:col-span-8 border-t border-line">
      {stack.map((group) => (
        <div class="grid gap-3 sm:grid-cols-[10rem_1fr] sm:gap-6 py-5 border-b border-line">
          <dt class="font-semibold">{group.area}</dt>
          <dd>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full bg-white border border-line px-3 py-1 text-[15px]">{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
