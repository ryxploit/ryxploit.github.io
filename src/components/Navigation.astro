---
// Navigation Component
const links = [
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#stack', label: 'Stack' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur border-b border-line">
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-6" aria-label="Principal">
    <a href="#inicio" class="font-bold text-lg tracking-tight shrink-0">Carlos León</a>

    <ul class="flex items-center gap-5 sm:gap-8 text-[15px] overflow-x-auto">
      {links.map((link) => (
        <li class:list={[(link.href === '#sobre-mi' || link.href === '#stack') && 'hidden sm:block']}>
          <a href={link.href} class="text-muted hover:text-ink transition-colors whitespace-nowrap">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
