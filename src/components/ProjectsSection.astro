---
// Projects Section Component
const projects = [
  {
    name: "Presupuestos.com.mx",
    role: "Fundador y desarrollador",
    description: "Un agente de presupuestos: le dices en palabras qué vas a cobrar y a quién, y arma la cotización en PDF con tu logo, IVA desglosado y folio consecutivo, lista para mandar por WhatsApp desde el celular.",
    url: "https://www.presupuestos.com.mx/",
    domain: "presupuestos.com.mx",
    shot: "/assets/shot-presupuestos.jpg",
  },
  {
    name: "ManoApp",
    role: "Fundador y desarrollador",
    description: "App para encontrar plomeros, electricistas y expertos en limpieza verificados en Mazatlán. Publicas lo que necesitas, comparas cotizaciones con precio fijo y pagas directo al terminar.",
    url: "https://manoapp.mx/",
    domain: "manoapp.mx",
    shot: "/assets/shot-manoapp.jpg",
  },
  {
    name: "Rentinno",
    role: "Fundador y desarrollador",
    description: "RentiFlow atiende a los huéspedes de rentas vacacionales por WhatsApp las 24 horas: califica fechas y presupuesto, sugiere propiedades y avisa al anfitrión cuando hay una reserva lista para cerrar.",
    url: "https://www.rentinno.com.mx/",
    domain: "rentinno.com.mx",
    shot: "/assets/shot-rentinno.jpg",
  },
  {
    name: "Juan Espinosa Luna · MGA",
    role: "Desarrollador",
    description: "Radar y alertas de lluvia intensa para tu zona: combina satélite GOES-19, radar RainViewer y pronóstico de Open-Meteo, y avisa cuando se esperan 15 mm/h o más en las próximas 6 horas. Los suscriptores reciben pronósticos del Dr. Juan Espinosa Luna.",
    url: "https://juanespinosaluna-mga.com/",
    domain: "juanespinosaluna-mga.com",
    shot: "/assets/shot-mga.jpg",
  },
];
---

<section id="proyectos" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="max-w-2xl">
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight">Proyectos</h2>
      <p class="mt-4 text-lg text-muted">
        Productos en uso, de la idea al código. Tres los fundé y en todos escribo el software.
      </p>
    </div>

    <div class="mt-14 lg:mt-20 divide-y divide-line">
      {projects.map((project) => (
        <article class="grid gap-8 lg:grid-cols-12 lg:gap-12 py-12 first:pt-0 last:pb-0">
          <div class="lg:col-span-5 lg:py-4 flex flex-col">
            <p class="text-sm font-medium text-muted">{project.role}</p>
            <h3 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight">{project.name}</h3>
            <p class="mt-5 text-lg leading-relaxed text-ink/80 max-w-[46ch]">{project.description}</p>
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 self-start inline-flex items-center gap-2 font-semibold underline decoration-marigold decoration-[3px] underline-offset-[6px] hover:decoration-ink transition-colors"
            >
              Visitar {project.domain}
              <span class="sr-only">(abre en una pestaña nueva)</span>
            </a>
          </div>

          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            aria-hidden="true"
            class="lg:col-span-7 block rounded-2xl border border-line bg-white shadow-[0_24px_48px_-28px_rgb(21_35_59/0.35)] overflow-hidden transition-transform duration-300 hover:-translate-y-1"
          >
            <div class="flex items-center h-9 px-4 border-b border-line bg-paper/60">
              <span class="mx-auto rounded-md bg-white border border-line px-3 py-0.5 text-xs text-muted">{project.domain}</span>
            </div>
            <img
              src={project.shot}
              alt={`Página principal de ${project.name}`}
              width="1280"
              height="800"
              loading="lazy"
              decoding="async"
              class="block w-full h-auto"
            />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
