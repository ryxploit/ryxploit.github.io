---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Carlos León">
	<main class="min-h-screen mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col justify-center py-20">
		<p class="font-semibold text-muted">Error 404</p>
		<h1 class="mt-3 text-display font-bold max-w-[14ch]">Esta página no existe.</h1>
		<p class="mt-6 text-xl text-muted max-w-[42ch]">
			Puede que el enlace esté mal escrito o que la página se haya movido.
		</p>
		<div class="mt-10 flex flex-wrap gap-3">
			<a href="/" class="inline-flex items-center rounded-full bg-ink px-6 py-3 font-semibold text-paper hover:bg-ink/85 transition-colors">
				Ir al inicio
			</a>
			<a href="/#contacto" class="inline-flex items-center rounded-full border border-ink/25 px-6 py-3 font-semibold hover:border-ink transition-colors">
				Escríbeme
			</a>
		</div>
	</main>
</Layout>
